<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/wifi_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/wifi_progress"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp"
                android:layout_marginBottom="-7dp"
                android:indeterminate="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <ListView
                android:id="@+id/wifi_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:divider="@null"
                android:layout_weight="1"
                android:overScrollMode="never"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/wifi_text"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_no_printers_found_title"/>
                <TextView
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_no_printers_found_text_wifi"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bt_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/bt_progress"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp"
                android:layout_marginBottom="-7dp"
                android:indeterminate="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <ListView
                android:id="@+id/bt_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:divider="@null"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/bt_text"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_no_printers_found_title"/>
                <TextView
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_no_printers_found_text_bluetooth"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/usb_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/usb_progress"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp"
                android:layout_marginBottom="-7dp"
                android:indeterminate="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <ListView
                android:id="@+id/usb_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:divider="@null"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/usb_text"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_no_printers_found_title"/>
                <TextView
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_no_printers_found_text_usb"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ads_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_dock_floating"
        android:elevation="8.0dp"
        android:paddingStart="16.0dp"
        android:paddingEnd="16.0dp"
        android:paddingTop="10.0dp"
        android:paddingBottom="6.0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56.0dp">
            <ImageView
                android:id="@+id/btn_wifi"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_wifi"
                android:scaleType="center"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/btn_bt"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_bluetooth"
                android:scaleType="center"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/btn_usb"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_usb"
                android:scaleType="center"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:background="#F1F5F9"
            android:layout_width="match_parent"
            android:layout_height="1.0dp"
            android:layout_marginTop="6.0dp"
            android:layout_marginBottom="4.0dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2.0dp"
            android:paddingBottom="2.0dp"
            android:text="@string/footer_made_by"
            android:textSize="11.0sp"
            android:textColor="#94A3B8"/>
    </LinearLayout>
</LinearLayout>
