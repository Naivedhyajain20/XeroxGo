<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F5F9">

    <!-- Top App Bar with XeroxGo title and USB OTG Connected Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64.0dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18.0dp"
        android:paddingEnd="18.0dp"
        android:background="#FFFFFFFF"
        android:elevation="2.0dp">

        <TextView
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="@string/app_name"
            android:textSize="20.0sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32.0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_otg"
            android:paddingStart="12.0dp"
            android:paddingEnd="12.0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ USB OTG Connected"
                android:textColor="#FFFFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Ready to Print Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16.0dp"
        android:paddingEnd="16.0dp"
        android:paddingTop="14.0dp"
        android:paddingBottom="4.0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_modern"
            android:elevation="2.0dp"
            android:padding="16.0dp">

            <View
                android:layout_width="22.0dp"
                android:layout_height="22.0dp"
                android:background="@drawable/bg_circle_blue"
                android:backgroundTint="#15803D"
                android:layout_marginStart="4.0dp"
                android:layout_marginEnd="14.0dp" />

            <LinearLayout
                android:layout_width="0.0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HP LaserJet M1005 MFP - Ready to Print"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="#15803D"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dp"
                    android:text="Mains Powered • Ink Levels: Good"
                    android:textSize="12.0sp"
                    android:textColor="#64748B"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Main List of Documents, Photos, Web -->
    <ListView
        android:id="@id/list"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0"
        android:divider="@null"
        android:dividerHeight="0.0dp"
        android:paddingTop="4.0dp"
        android:overScrollMode="never" />

    <FrameLayout
        android:id="@id/ads_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.0dp" />

    <!-- Modern Elevated Bottom Dock with Change Printer pill button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dock_floating"
        android:elevation="8.0dp"
        android:paddingStart="16.0dp"
        android:paddingEnd="16.0dp"
        android:paddingTop="10.0dp"
        android:paddingBottom="6.0dp">

        <LinearLayout
            android:id="@id/select_button"
            android:layout_width="match_parent"
            android:layout_height="56.0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:selectableItemBackground">

            <ImageView
                android:id="@id/printer_status"
                android:layout_width="32.0dp"
                android:layout_height="32.0dp"
                android:src="@drawable/printer"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0.0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:orientation="vertical"
                android:layout_marginStart="12.0dp"
                android:layout_marginEnd="8.0dp">

                <TextView
                    android:id="@id/printer_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_not_selected"
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@id/printer_owner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12.0sp"
                    android:textColor="#64748B"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <!-- Change Button matching user image -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36.0dp"
                android:background="@drawable/bg_button_navy_pill"
                android:text="Change"
                android:textColor="#FFFFFFFF"
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="18.0dp"
                android:paddingEnd="18.0dp" />

        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.0dp"
            android:layout_marginTop="6.0dp"
            android:layout_marginBottom="4.0dp"
            android:background="#F1F5F9" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2.0dp"
            android:paddingBottom="2.0dp"
            android:text="@string/footer_made_by"
            android:textSize="11.0sp"
            android:textColor="#94A3B8" />

    </LinearLayout>

</LinearLayout>
