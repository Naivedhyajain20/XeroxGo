<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F5F9">

    <!-- Top App Bar for Print Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56.0dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2563EB"
        android:paddingStart="16.0dp"
        android:paddingEnd="16.0dp"
        android:elevation="4.0dp">

        <TextView
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="←  Print Preview"
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings ›"
            android:textSize="13.0sp"
            android:textStyle="bold"
            android:textColor="#E0E7FF"
            android:padding="6.0dp" />
    </LinearLayout>

    <!-- Document Preview Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0"
        android:layout_marginTop="8.0dp"
        android:layout_marginBottom="4.0dp"
        android:layout_marginStart="8.0dp"
        android:layout_marginEnd="8.0dp"
        android:scrollbars="none" />

    <FrameLayout
        android:id="@id/ads_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.0dp" />

    <!-- Modern Rounded Settings Card matching user screenshot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16.0dp"
        android:paddingEnd="16.0dp"
        android:paddingBottom="6.0dp">

        <LinearLayout
            android:id="@id/settings_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_modern"
            android:elevation="3.0dp"
            android:paddingStart="16.0dp"
            android:paddingEnd="16.0dp"
            android:paddingTop="12.0dp"
            android:paddingBottom="12.0dp">

            <!-- Row 1: Paper Size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44.0dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="28.0dp"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="18.0sp" />

                <TextView
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:text="Paper Size"
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@id/paper_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14.0sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ›"
                    android:textSize="16.0sp"
                    android:textColor="#94A3B8"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="#F1F5F9" />

            <!-- Row 2: Orientation & Layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44.0dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="28.0dp"
                    android:layout_height="wrap_content"
                    android:text="🔄"
                    android:textSize="18.0sp" />

                <TextView
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:text="Orientation"
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@id/paper_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13.0sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:singleLine="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="#F1F5F9" />

            <!-- Row 3: Copies & Source -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44.0dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="28.0dp"
                    android:layout_height="wrap_content"
                    android:text="📑"
                    android:textSize="18.0sp" />

                <TextView
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:text="Copies / Source"
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@id/paper_tray"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13.0sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:singleLine="true" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls: Printer Selector + Big PRINT Pill Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dock_floating"
        android:elevation="8.0dp"
        android:paddingStart="16.0dp"
        android:paddingEnd="16.0dp"
        android:paddingTop="10.0dp"
        android:paddingBottom="6.0dp">

        <!-- Selected Printer Row -->
        <LinearLayout
            android:id="@id/select_button"
            android:layout_width="match_parent"
            android:layout_height="42.0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:selectableItemBackground"
            android:paddingStart="4.0dp"
            android:paddingEnd="4.0dp">

            <ImageView
                android:id="@id/printer_status"
                android:layout_width="24.0dp"
                android:layout_height="24.0dp"
                android:src="@drawable/printer"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@id/printer_name"
                android:layout_width="0.0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="10.0dp"
                android:layout_marginEnd="6.0dp"
                android:text="@string/label_not_selected"
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@id/printer_owner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change ›"
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />
        </LinearLayout>

        <!-- Big Royal Blue PRINT Pill Button matching user image -->
        <Button
            android:id="@id/print_button"
            android:layout_width="match_parent"
            android:layout_height="52.0dp"
            android:layout_marginTop="8.0dp"
            android:layout_marginBottom="4.0dp"
            android:background="@drawable/bg_button_print_pill"
            android:text="🖨️  PRINT"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:elevation="4.0dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2.0dp"
            android:paddingBottom="2.0dp"
            android:text="@string/footer_made_by"
            android:textSize="11.0sp"
            android:textColor="#94A3B8" />

    </LinearLayout>

</LinearLayout>
