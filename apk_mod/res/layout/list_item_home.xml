<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16.0dp"
    android:paddingEnd="16.0dp"
    android:paddingTop="6.0dp"
    android:paddingBottom="6.0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_modern"
        android:elevation="2.0dp"
        android:padding="16.0dp">

        <FrameLayout
            android:layout_width="48.0dp"
            android:layout_height="48.0dp"
            android:background="@drawable/bg_circle_blue"
            android:padding="10.0dp">

            <ImageView
                android:id="@id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:layout_marginStart="14.0dp"
            android:layout_marginEnd="8.0dp">

            <TextView
                android:id="@id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:singleLine="true"
                android:ellipsize="end"
                android:textAlignment="viewStart" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="20.0sp"
            android:textColor="#94A3B8"
            android:textStyle="bold"
            android:layout_marginEnd="4.0dp" />

    </LinearLayout>

</LinearLayout>
