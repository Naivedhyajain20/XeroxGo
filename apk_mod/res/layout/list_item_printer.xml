<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16.0dp"
    android:paddingEnd="16.0dp"
    android:paddingTop="5.0dp"
    android:paddingBottom="5.0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_modern"
        android:elevation="2.0dp"
        android:padding="14.0dp">

        <FrameLayout
            android:layout_width="44.0dp"
            android:layout_height="44.0dp"
            android:background="@drawable/bg_circle_blue"
            android:padding="8.0dp">

            <ImageView
                android:id="@id/printer_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:layout_marginStart="14.0dp"
            android:layout_marginEnd="8.0dp">

            <TextView
                android:id="@id/printer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_not_selected"
                android:textSize="15.0sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:singleLine="true"
                android:ellipsize="end"
                android:textAlignment="viewStart" />

            <TextView
                android:id="@id/printer_owner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12.0sp"
                android:textColor="#64748B"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone"
                android:textAlignment="viewStart" />
        </LinearLayout>

        <ImageView
            android:id="@id/printer_current"
            android:layout_width="24.0dp"
            android:layout_height="24.0dp"
            android:src="@drawable/checkmark_on"
            android:scaleType="fitCenter"
            android:layout_marginEnd="4.0dp" />

    </LinearLayout>

</LinearLayout>
